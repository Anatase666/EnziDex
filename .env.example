# ─────────────────────────────────────────────────────────────────────────────
# ЭнзиДекс — переменные окружения
# Скопируйте файл в .env.local и заполните значения. .env.local в .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Канонический адрес сайта. Используется для sitemap.xml, robots.txt,
# канонических URL и абсолютных ссылок на OG-изображения.
NEXT_PUBLIC_SITE_URL=https://enzidex.ru

# Подкаталог, если сайт публикуется не в корне домена (GitHub Pages: /имя-репозитория).
# Для корня домена и для локальной разработки — оставить пустым (ТЗ 6.2).
NEXT_PUBLIC_BASE_PATH=

# ─── Транспорт заявок (ТЗ FR-G3) ─────────────────────────────────────────────
# Активный транспорт: formspree | telegram | webhook | console
# console — режим разработки: заявка печатается в консоль браузера, никуда не уходит.
NEXT_PUBLIC_LEAD_TRANSPORT=console

# Вариант A (по умолчанию): Formspree. Полный endpoint формы.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Вариант B: собственная serverless-функция (Vercel / Cloudflare Worker),
# которая уже внутри себя дёргает Telegram Bot API. Токен бота живёт ТАМ, не здесь.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# ─── Аналитика (ТЗ 8.5) ──────────────────────────────────────────────────────
# Пусто = аналитика не подключается и cookie-баннер не нужен.
NEXT_PUBLIC_YM_ID=
