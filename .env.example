# ─────────────────────────────────────────────────────────────────────────────
# ЭнзиДекс — переменные окружения
# Скопируйте файл в .env.local и заполните значения. .env.local в .gitignore.
#
# Переменных мало по одной причине: сайт информационный. Он не принимает
# заявок, не собирает персональные данные и не обращается ни к одному
# внешнему сервису в рантайме — настраивать, по сути, нечего.
# ─────────────────────────────────────────────────────────────────────────────

# Канонический адрес сайта. Используется для sitemap.xml, robots.txt,
# канонических URL и абсолютных ссылок на OG-изображение.
NEXT_PUBLIC_SITE_URL=https://enzidex.ru

# Подкаталог, если сайт публикуется не в корне домена (GitHub Pages: /имя-репозитория).
# Для корня домена и для локальной разработки — оставить пустым (ТЗ 6.2).
NEXT_PUBLIC_BASE_PATH=
